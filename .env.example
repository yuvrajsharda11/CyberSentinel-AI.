# Copy to .env and set a strong bootstrap admin before the first hosted run.
CYBERSENTINEL_ENV=production
CYBERSENTINEL_DEMO_ADMIN=0
CYBERSENTINEL_ADMIN_USERNAME=admin
CYBERSENTINEL_ADMIN_PASSWORD=Replace-With-Long-Unique-Password-123!
CYBERSENTINEL_EVIDENCE_DIR=/app/data/evidence
# Required only for the optional public HTTPS profile. Point this DNS name to the VPS first.
CYBERSENTINEL_DOMAIN=cybersentinel.example.com
# Optional domain reputation provider
VIRUSTOTAL_API_KEY=
